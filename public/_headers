/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-src 'self' https://vidhide.com https://filemoon.sx https://voe.sx https://vidsrc.to; media-src 'self' https: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://hikaritv.com https://hikaritv.cc.cd https://hikariplayer.cc

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/anime/*
  Cache-Control: public, max-age=60

/e/*
  Cache-Control: public, max-age=60

/sitemap.xml
  Cache-Control: public, max-age=3600
