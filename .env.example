# PostgreSQL Neon exclusivo do Player (server-side only, nunca expor em VITE_*)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Senha administrativa para acessar /admin (nunca armazenar ou expor no cliente)
PLAYER_ADMIN_PASSWORD=""

# Segredo criptográfico (mínimo 32 caracteres aleatórios) usado para assinar cookies de sessão e URLs de proxy
PLAYER_SESSION_SECRET=""

# URL pública canônica do Player para geração de links compartilháveis (ex.: https://player.seudominio.com)
PLAYER_PUBLIC_BASE_URL="http://localhost:3000"

# Opcional: Referer/Origin personalizados para fontes especiais (padrão: https://maximaimg.online/)
# PLAYER_MAXIMAIMG_REFERER="https://maximaimg.online/"

